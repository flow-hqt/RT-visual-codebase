{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Universal Compile", 
            "command": "g++",
            "args": [
                "-g",
                "${file}", 
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe" 
            ],
            "options": {
                "cwd": "${fileDirname}" 
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "通用编译任务"
        }
    ]
}