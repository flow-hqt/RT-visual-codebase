# ==============================================
# 通用忽略规则（所有语言/环境通用）
# ==============================================
# 操作系统相关
# macOS 缓存文件
.DS_Store
# Windows 缩略图缓存
Thumbs.db
# Vim 临时文件
*.swp
# Vim 交换文件
*.swo
# 部分编辑器的临时文件（如Emacs）
*~

# 编辑器/IDE 配置（除非团队共享，否则忽略）
# JetBrains 系列（CLion、PyCharm等）
.idea/
# VSCode 个人配置（settings.json、launch.json等）
.vscode/
# 例外：保留团队共享的扩展推荐列表
!.vscode/extensions.json
# 例外：若有统一构建任务，可保留
!.vscode/tasks.json
# 例外：若你想把我们刚才配好的launch.json也传上去，请把下面这行前面的井号去掉
# !.vscode/launch.json

# Visual Studio 解决方案配置
*.suo
# Visual Studio 用户配置
*.user
# Cloud9 编辑器配置
.c9/
# Visual Studio 工作区文件
.vs/

# 日志、临时文件和缓存
logs/
*.log
tmp/
temp/
.cache/
# Python 测试缓存
.pytest_cache/

# 压缩包/安装包（不提交二进制分发文件）
*.zip
*.tar.gz
*.tar.bz2
*.7z
*.exe
*.deb
*.rpm

# 敏感信息文件（本地配置、密钥等）
.env
.env.local
*.key
*.pem
config.local

# ==============================================
# Python 特有忽略规则
# ==============================================
# 字节码和缓存
__pycache__/
*.py[cod]
*$py.class
# Python 编译的C扩展（若手动维护则保留）
*.so

# 虚拟环境（本地依赖环境，不共享）
venv/
env/
ENV/
*.venv
.venv/
env.bak/
venv.bak/

# 包管理与构建产物
# 打包输出（如pip wheel）
dist/
# 构建目录
build/
# 鸡蛋包元信息
*.egg-info/
*.eggs/
# 包清单（自动生成）
MANIFEST
# 自动生成的依赖锁（手动维护的requirements.txt不忽略）
requirements.txt.lock

# 数据与模型（大文件建议用Git LFS或外部存储）
# PyTorch 模型
*.pth
*.pt
# Keras/TensorFlow 模型
*.h5
# 检查点文件
*.ckpt
# 本地数据（样本数据可放docs/data并取消忽略）
*.csv
# NumPy 数据
*.npy
*.npz
# 本地数据目录（若需共享样本，可改为!data/samples/）
data/

# 测试与覆盖率报告
.coverage
htmlcov/
.pytest_cache/
# 多环境测试工具缓存
.tox/

# ==============================================
# C++ 特有忽略规则
# ==============================================
# 编译产物
# 目标文件
*.o
*.obj
# 可执行文件（Linux）
*.out
# 可执行文件（Windows）
*.exe
# 动态链接库（Linux）
*.so
# 动态链接库（Windows）
*.dll
# 静态库（Linux）
*.a
# 静态库（Windows）
*.lib
# Libtool 目标文件
*.lo
# 共享目标文件
*.slo

# 编译与构建目录
# 通用构建目录
build/
# CLion/CMake 构建目录
cmake-build-*/
# 部分IDE的输出目录
out/
# 二进制文件目录
bin/
# 目标文件目录
obj/

# CMake 相关临时文件
CMakeCache.txt
CMakeFiles/
Makefile
Makefile.in
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# 预编译头文件
*.gch
*.pch

# 其他工具链产物
# Automake 依赖目录
.deps/
# Libtool 库目录
.libs/
# Ninja 构建文件
*.ninja
build.ninja
rules.ninja

# ==============================================
# 视觉组项目特有忽略（图片/视频等大文件）
# ==============================================
# 大尺寸媒体文件（建议用链接或Git LFS管理）
*.bmp
*.jpg
*.jpeg
*.png
*.tiff
*.gif
*.mp4
*.avi
*.mov
*.mkv

# 例外：保留文档中的示例小图
!docs/examples/*.png
!docs/examples/*.jpg

# 临时测试脚本（本地调试用，不提交）
test_*.py
test_*.cpp
test_*.h